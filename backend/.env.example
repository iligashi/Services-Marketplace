# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=services_marketplace

# JWT
# Two different random values, 32+ characters each. Required outside
# development; when unset in development a random per-process secret is used.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
PLATFORM_FEE_PERCENT=12

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Redis (optional). When set, rate limits are shared across API instances.
# Use REDIS_URL, or REDIS_HOST + REDIS_PORT.
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL (CORS)
CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001
