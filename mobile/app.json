{
  "expo": {
    "name": "Services Marketplace",
    "slug": "services-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketplace.services",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0984e3"
      },
      "package": "com.marketplace.services"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0984e3"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b67a27a8-ac17-43ae-be4e-d1846d5d6202"
      }
    },
    "owner": "ilaz",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b67a27a8-ac17-43ae-be4e-d1846d5d6202"
    }
  }
}
