# Local Docker Compose credentials. Replace these values before starting.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-local-password
MYSQL_USER=services_app
MYSQL_PASSWORD=replace-with-a-unique-local-password

# Token signing secrets: two different random values, 32+ characters each.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
